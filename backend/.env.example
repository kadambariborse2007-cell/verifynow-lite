# PostgreSQL connection: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/verifynow

# Long random string used to sign JWT tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Base URL put inside the QR code. Use your laptop's local IP (e.g. http://192.168.1.5:8000)
# if you want to scan the QR from a phone on the same WiFi.
PUBLIC_BASE_URL=http://localhost:8000
